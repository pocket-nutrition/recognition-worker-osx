# Copy this file to .env, then set WORKER_SERVER_URL and WORKER_KEY (cp .env.example .env).
# Every setting you would normally change (worker/config.py) is listed. Values shown are the code defaults, except the two without
# a default (WORKER_SERVER_URL, WORKER_KEY) and WORKER_LLM_MODEL, which is a recommended model rather than the code default.

# --- Recognition server (https://github.com/pocket-nutrition/recognition) ---

# Base URL of the recognition server this worker pulls jobs from (placeholder: replace with your own server).
WORKER_SERVER_URL=https://recognition.example.org
# Secret: the worker's own key issued by that server (never a phone key). Leave it empty here and set it in .env only.
WORKER_KEY=
# Seconds one long poll waits for a job; must stay at or below the server's maximum wait (25).
WORKER_CLAIM_WAIT_S=20
# Seconds between heartbeats that keep a job's lease alive during slow stages.
WORKER_HEARTBEAT_S=30

# --- Speech-to-text: Handy's headless mode with the Cohere Transcribe model ---

# Path to the Handy executable.
WORKER_HANDY_BIN=/Applications/Handy.app/Contents/MacOS/handy
# Handy model used for transcription (download it in Handy first).
WORKER_HANDY_MODEL=handy-computer/cohere-transcribe-03-2026-gguf/cohere-transcribe-03-2026-Q5_K_M.gguf
# ffmpeg executable (name on PATH or absolute path): decodes audio and re-encodes photos.
WORKER_FFMPEG_BIN=ffmpeg
# Longest audio clip transcribed, in seconds; the rest is cut off.
WORKER_MAX_AUDIO_SECS=120
# Seconds before a transcription is abandoned.
WORKER_STT_TIMEOUT_S=120

# --- Extraction: any local OpenAI-compatible server (LM Studio listens on port 1234 by default) ---

# Base URL of that server, including /v1.
WORKER_LLM_URL=http://127.0.0.1:1234/v1
# Model that turns a transcript into foods; it must be loaded in the server.
WORKER_LLM_MODEL=google/gemma-4-e4b
# Seconds before a model call is abandoned.
WORKER_LLM_TIMEOUT_S=120
# Most foods kept from one recording or photo; extra ones are dropped.
WORKER_MAX_ITEMS=20

# --- Photos ---

# Model that reads photos; it must accept images. Empty means WORKER_LLM_MODEL is used.
WORKER_VISION_MODEL=
# Language photo queries are written in, "fr" or "en" (a photo carries no language of its own).
WORKER_VISION_LANGUAGE=fr
# Longest side in pixels after the photo is re-encoded and before the model sees it.
WORKER_MAX_IMAGE_PX=1024

# --- Ingredient search ---

# Public API used to turn ingredient names into candidates.
WORKER_API_URL=https://api.pocketnutrition.org
# Candidates kept per food.
WORKER_CANDIDATES_PER_ITEM=5

# --- Vault deposit ---

# Seconds before one deposit attempt is abandoned.
WORKER_VAULT_TIMEOUT_S=10
# Seconds to wait before each retry of a failed deposit, as a JSON list (one entry per retry).
WORKER_VAULT_RETRY_DELAYS_S=[1, 5, 30]
# Vault hosts you run that may resolve to a private address (split-horizon DNS on your own network); empty = public addresses only.
WORKER_VAULT_TRUSTED_HOSTS=
